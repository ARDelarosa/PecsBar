
<div class="min-h-screen bg-pecs-black px-4 py-10 text-white sm:px-8 lg:px-12">
  <div class="mx-auto max-w-7xl">

    <%# Page header %>
    <header class="flex flex-col gap-5 border-b border-pecs-green/30 pb-8 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <%= link_to "← Admin Dashboard", management_root_path,
            class: "text-sm font-semibold text-pecs-light-gray transition hover:text-pecs-green" %>

        <h1 class="mt-4 text-3xl font-black sm:text-4xl">
          Manage <span class="text-pecs-green">All Events</span>
        </h1>

        <p class="mt-2 text-pecs-light-gray">
          View, edit, and manage every scheduled Pecs Bar event.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= link_to "← Admin Calendar", management_events_path,
            class: "rounded-full border border-white/20 px-5 py-3 text-sm font-bold transition hover:border-pecs-green hover:text-pecs-green" %>

        <%= link_to "+ Create Event", new_event_path(return_to: "admin"),
            class: "rounded-full bg-pecs-green px-5 py-3 text-sm font-black text-pecs-black transition hover:bg-white" %>
      </div>
    </header>

    <%# Event count %>
    <div class="mt-8 rounded-xl border border-pecs-green/20 bg-pecs-gray p-5">
      <p class="text-sm font-semibold text-pecs-light-gray">Total Events</p>
      <p class="mt-1 text-3xl font-black text-pecs-green">
        <%= @events.count %>
      </p>
    </div>

    <%# Events table %>
    <section class="mt-8 overflow-hidden rounded-2xl border border-white/10 bg-pecs-gray">
      <% if @events.any? %>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[700px] text-left">
            <thead class="bg-pecs-black text-xs uppercase tracking-wider text-pecs-light-gray">
              <tr>
                <th class="px-6 py-4">Event</th>
                <th class="px-6 py-4">Date</th>
                <th class="px-6 py-4">Time</th>
                <th class="px-6 py-4">Flyer</th>
                <th class="px-6 py-4 text-right">Actions</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-white/10">
              <% @events.each do |event| %>
                <tr class="transition hover:bg-pecs-black/40">
                  <td class="px-6 py-5">
                    <p class="font-bold"><%= event.title %></p>
                    <p class="mt-1 max-w-xs truncate text-sm text-pecs-light-gray">
                      <%= event.description.presence || "No description" %>
                    </p>
                  </td>

                  <td class="whitespace-nowrap px-6 py-5 text-sm">
                    <%= event.event_date.strftime("%b %-d, %Y") %>
                  </td>

                  <td class="whitespace-nowrap px-6 py-5 text-sm text-pecs-light-gray">
                    <%= event.start_time&.strftime("%-I:%M %p") || "TBA" %>
                  </td>

                  <td class="px-6 py-5 text-sm">
                    <% if event.flyer.attached? %>
                      <span class="font-bold text-pecs-green">Uploaded</span>
                    <% else %>
                      <span class="text-pecs-light-gray">None</span>
                    <% end %>
                  </td>

                  <td class="px-6 py-5">
                    <div class="flex justify-end gap-3">
                      <%= link_to "Edit", edit_event_path(event, return_to: "admin"),
                          class: "rounded-full border border-pecs-green/40 px-4 py-2 text-sm font-bold text-pecs-green transition hover:bg-pecs-green hover:text-pecs-black" %>

                      <%= button_to "Delete", event_path(event),
                          method: :delete,
                          params: { return_to: "admin", return_page: "all" },
                          form: { data: { turbo_confirm: "Are you sure you want to delete this event?" } },
                          class: "rounded-full border border-red-500/40 px-4 py-2 text-sm font-bold text-red-400 transition hover:bg-red-500 hover:text-white" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-12 text-center">
          <p class="text-4xl">📅</p>
          <h2 class="mt-4 text-xl font-bold">No events yet</h2>
          <p class="mt-2 text-pecs-light-gray">
            Create your first event and it will appear here.
          </p>

          <%= link_to "+ Create Event", new_event_path(return_to: "admin"),
              class: "mt-6 inline-block rounded-full bg-pecs-green px-6 py-3 font-black text-pecs-black transition hover:bg-white" %>
        </div>
      <% end %>
    </section>

    <footer class="mt-12 border-t border-white/10 pt-6 text-center text-sm text-pecs-light-gray">
      Pecs Bar Admin Portal
    </footer>

  </div>
</div>
