<div class="min-h-screen bg-pecs-black px-6 py-16 text-white">
  <div class="mx-auto max-w-3xl">

    <%= link_to "← Back to Events", events_path,
        class: "font-bold text-pecs-green transition hover:underline" %>

    <div class="mt-8 rounded-2xl border border-white/10 bg-pecs-gray p-8 md:p-12">

      <p class="text-sm font-bold uppercase tracking-widest text-pecs-green">
        <%= @event.event_date.strftime("%A • %B %-d, %Y") %>
      </p>

      <h1 class="mt-4 text-4xl font-black uppercase md:text-5xl">
        <%= @event.title %>
      </h1>

      <p class="mt-6 font-bold text-white">
        <%= @event.start_time.strftime("%-I:%M %p") %>
        <% if @event.end_time.present? %>
          – <%= @event.end_time.strftime("%-I:%M %p") %>
        <% end %>
      </p>

      <div class="mt-8 leading-8 text-pecs-light-gray">
        <%= simple_format(@event.description) %>
      </div>

      <div class="mt-10 rounded-xl border border-pecs-green/30 bg-pecs-black p-8 text-center">
        <p class="text-4xl">🍻</p>
        <p class="mt-3 font-bold text-pecs-green">
          Event flyer coming soon
        </p>
      </div>

    </div>
  </div>
</div>
