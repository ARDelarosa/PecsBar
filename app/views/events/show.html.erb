<div class="min-h-screen bg-pecs-black px-6 py-16 text-white">
  <div class="mx-auto max-w-3xl">

    <%= link_to "← Back to Events", events_path,
        class: "font-bold text-pecs-green transition hover:underline" %>

    
    <% if notice.present? %>
    <div class="mt-6 rounded-lg border border-pecs-green/30 bg-pecs-green/10 px-4 py-3 font-semibold text-pecs-green"
        role="status">
        <%= notice %>
    </div>
    <% end %>

    <div class="mt-8 rounded-2xl border border-white/10 bg-pecs-gray p-8 md:p-12">

      <p class="text-sm font-bold uppercase tracking-widest text-pecs-green">
        <%= @event.event_date.strftime("%A • %B %-d, %Y") %>
      </p>

      <h1 class="mt-4 text-4xl font-black uppercase md:text-5xl">
        <%= @event.title %>
      </h1>

      <p class="mt-6 font-bold text-white">
        <%= @event.start_time.strftime("%-I:%M %p") %>
        <% if @event.end_time.present? %>
          – <%= @event.end_time.strftime("%-I:%M %p") %>
        <% end %>
      </p>

      <div class="mt-8 leading-8 text-pecs-light-gray">
        <%= simple_format(@event.description) %>
      </div>

      <% if @event.flyer.attached? %>
        <div class="mt-10">
            <%= link_to rails_blob_path(@event.flyer, disposition: "inline"),
                target: "_blank",
                rel: "noopener",
                class: "block overflow-hidden rounded-xl border border-pecs-green/30 transition hover:border-pecs-green" do %>

            <%= image_tag @event.flyer,
                alt: "#{@event.title} event flyer",
                class: "h-auto w-full object-contain transition duration-300 hover:scale-[1.02]" %>

            <% end %>

            <p class="mt-3 text-center text-sm text-pecs-light-gray">
            Click the flyer to view it larger
            </p>
        </div>
        <% else %>
        <div class="mt-10 rounded-xl border border-pecs-green/30 bg-pecs-black p-8 text-center">
            <p class="text-4xl">🍻</p>
            <p class="mt-3 font-bold text-pecs-green">
            Event flyer coming soon
            </p>
        </div>
        <% end %>

        <div class="mt-8 rounded-xl border border-white/10 bg-pecs-black p-6">
            <h2 class="text-xl font-bold text-pecs-green">
                <%= @event.flyer.attached? ? "Replace Event Flyer" : "Upload Event Flyer" %>
            </h2>

            <%= form_with model: @event, method: :patch, class: "mt-4 space-y-4" do |form| %>
                <div>
                <%= form.label :flyer, "Choose an image",
                    class: "mb-2 block font-semibold text-white" %>

                <%= form.file_field :flyer,
                    accept: "image/*",
                    class: "block w-full text-sm text-pecs-light-gray file:mr-4 file:rounded-full file:border-0 file:bg-pecs-green file:px-4 file:py-2 file:font-bold file:text-pecs-black hover:file:bg-white" %>
                </div>

                <%= form.submit(@event.flyer.attached? ? "Replace Flyer" : "Upload Flyer",
                    class: "rounded-full bg-pecs-green px-6 py-3 font-bold text-pecs-black transition hover:bg-white") %>
            <% end %>
            </div>

    </div>
  </div>
</div>
