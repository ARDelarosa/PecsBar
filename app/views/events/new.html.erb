
<div class="min-h-screen bg-pecs-black px-6 py-16 text-white">
  <div class="mx-auto max-w-3xl">

    <%= link_to "← Back to Events", events_path,
        class: "font-bold text-pecs-green transition hover:underline" %>

    <div class="mt-8 rounded-2xl border border-white/10 bg-pecs-gray p-8 md:p-12">

      <p class="text-sm font-bold uppercase tracking-widest text-pecs-green">
        Pecs Bar Admin
      </p>

      <h1 class="mt-3 text-4xl font-black uppercase">
        Create Event
      </h1>

      <p class="mt-4 text-pecs-light-gray">
        Add an event to the Pecs Bar calendar.
      </p>

        <%= render "form" %>

    </div>
  </div>
</div>
